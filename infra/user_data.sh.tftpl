#!/bin/bash
# Bootstrap for the Panal honeypot (rendered by Terraform templatefile).
set -euo pipefail
exec > /var/log/panal-bootstrap.log 2>&1

# 1. Move the real SSH server to the admin port; port 22 belongs to Cowrie.
cat > /etc/ssh/sshd_config.d/10-panal.conf <<'SSHD'
Port ${admin_ssh_port}
PasswordAuthentication no
PermitRootLogin no
SSHD
systemctl disable --now ssh.socket || true
rm -f /etc/systemd/system/ssh.service.d/00-socket.conf
rm -f /etc/systemd/system/ssh.socket.d/addresses.conf
systemctl daemon-reload
systemctl enable ssh.service
systemctl restart ssh.service

# 2. Docker from the Ubuntu archive.
export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y docker.io docker-compose-v2
systemctl enable --now docker

# 3. Egress lockdown: drop every NEW connection started from the honeypot network.
#    Attackers can still connect in and get replies; Cowrie can never call out
#    (no malware downloads, no attacks on third parties, no metadata access).
cat > /usr/local/sbin/panal-egress.sh <<'EGRESS'
#!/bin/sh
set -e
iptables -C DOCKER-USER -s 10.250.0.0/24 -m conntrack --ctstate NEW -j DROP 2>/dev/null \
  || iptables -I DOCKER-USER 1 -s 10.250.0.0/24 -m conntrack --ctstate NEW -j DROP
EGRESS
chmod 755 /usr/local/sbin/panal-egress.sh

# 4. Cowrie with a realistic hostname and a hardened container.
mkdir -p /opt/panal
cat > /opt/panal/docker-compose.yml <<'COMPOSE'
services:
  cowrie:
    image: ${cowrie_image}
    container_name: panal-cowrie
    hostname: ${honeypot_hostname}
    environment:
      COWRIE_HONEYPOT_HOSTNAME: ${honeypot_hostname}
    ports:
      - "22:2222"
    volumes:
      - cowrie-var:/cowrie/cowrie-git/var
    cap_drop:
      - ALL
    read_only: true
    security_opt:
      - no-new-privileges:true
    mem_limit: 512m
    pids_limit: 200
    networks:
      - trap

volumes:
  cowrie-var:

networks:
  trap:
    ipam:
      config:
        - subnet: 10.250.0.0/24
COMPOSE

# 5. systemd unit: apply the egress rule first, then start the honeypot (also after reboots).
cat > /etc/systemd/system/panal-honeypot.service <<'UNIT'
[Unit]
Description=Panal honeypot (Cowrie) with egress lockdown
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/panal
ExecStartPre=/usr/local/sbin/panal-egress.sh
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
UNIT
systemctl daemon-reload
systemctl enable --now panal-honeypot.service

echo "PANAL_BOOTSTRAP_OK"
